{
  "name": "@ekz/formix",
  "packageManager": "yarn@4.12.0",
  "version": "1.1.0",
  "description": "Type-safe React form to be used with Typescript",
  "keywords": [
    "react",
    "form",
    "formix",
    "typescript",
    "type-safe"
  ],
  "author": {
    "name": "Alan Heitkotter",
    "email": "heitkotter@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erkez/formix.git"
  },
  "bugs": {
    "url": "https://github.com/erkez/formix/issues"
  },
  "homepage": "https://github.com/erkez/formix#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@ekz/option": "^1.2.1",
    "immutable": "^4 || ^5",
    "react": "^16.8.0 || ^17 || ^18 || ^19",
    "typescript": "^4 || ^5"
  },
  "devDependencies": {
    "@ekz/option": "^1.2.6",
    "@ekz/packer": "^0.16.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "documentation": "^14.0.3",
    "immutable": "^5.1.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "npx jest",
    "lint": "npx eslint --ext .ts --ext .tsx .",
    "lint:fix": "yarn lint --fix",
    "build": "yarn build:dev",
    "build:watch": "yarn build:dev --watch",
    "build:dev": "npx webpack --mode=development",
    "build:prod": "npx webpack --mode=production",
    "declarations:ts": "npx tsc -d --declarationDir lib --emitDeclarationOnly --jsx react src/index.ts",
    "prepublish": "yarn test --ci --no-watchman && yarn lint && yarn build:prod && yarn declarations:ts"
  },
  "jest": {
    "testEnvironment": "jsdom"
  }
}
